# Copy to .env and replace every placeholder. Never commit real values.

# --- Database (PostgreSQL) ---
# Full connection string; if set it takes precedence over the DB_* variables
DATABASE_URL=postgresql://db_user:change-me@localhost:5434/diagram_studio
# Individual connection settings (used by scripts and docker-compose)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=diagram_studio
DB_USER=db_user
DB_PASSWORD=change-me

# --- Application ---
# Host port mapped to the app container by docker-compose
APP_PORT=3000
# Number of trusted reverse proxies in front of the app (0 = directly exposed)
TRUST_PROXY_HOPS=1
# Extra browser origins allowed to call /api/mcp (comma separated). CLI clients send no Origin; leave empty normally.
MCP_ALLOWED_ORIGINS=
# To let claude.ai / Claude Desktop / mobile connect (ADR-0005): MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# --- OAuth sign-in for the MCP server (ADR-0005; off by default) ---
# MCP_OAUTH_ENABLED=true turns on the discovery documents, the authorization server and OAuth tokens on /api/mcp.
MCP_OAUTH_ENABLED=false
# Issuer and canonical MCP URL; default to the NEXTAUTH_URL origin and <origin>/api/mcp
# OAUTH_ISSUER=https://lab.example.com
# MCP_PUBLIC_URL=https://lab.example.com/api/mcp
# Exact client_id URLs allowed to start a flow (comma separated; default: Claude's hosted client)
# OAUTH_TRUSTED_CLIENT_IDS=https://claude.ai/oauth/mcp-oauth-client-metadata

# --- Authentication (next-auth) ---
# Public base URL of the app; used for auth callbacks and password-reset links
NEXTAUTH_URL=http://localhost:3000
# Required; signs sessions and CAPTCHA challenges (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-a-long-random-string

# --- OAuth providers (optional; leave blank to disable) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Initial admin account (used by npm run db:seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Administrator

# --- Email delivery for password reset (SMTP, optional) ---
# Without SMTP_HOST and EMAIL_FROM no email is sent (links are only exposed in development)
SMTP_HOST=smtp.example.com
# SMTP port (default 587)
SMTP_PORT=587
# true for implicit TLS (typically port 465), false for STARTTLS
SMTP_SECURE=false
# SMTP credentials (omit both for an unauthenticated relay)
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
# Sender address, required when SMTP_HOST is set
EMAIL_FROM=Ontographia Lab <noreply@example.com>

# --- Client-side (exposed to the browser) ---
# No NEXT_PUBLIC_* variables are currently read by the app. Add any here if introduced.
